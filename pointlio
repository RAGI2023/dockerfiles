FROM ubuntu:20.04

# 避免交互式安装时的提示
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 设置语言环境
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8

# 更换为阿里云镜像源（可选，提高下载速度）
RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

# 安装基础工具
RUN apt-get update

RUN apt-get install -y \
    curl \
    wget \
    gnupg2 \
    lsb-release \
    software-properties-common \
    apt-transport-https \
    ca-certificates \
    build-essential \
    git \
    vim \
    nano \
    tmux \
    net-tools \
    iputils-ping \
    python3-pip \
    python3-dev 

# ====== 安装 ROS Noetic ======
# 添加 ROS 1 仓库
RUN sh -c 'echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-noetic.list'

# 添加 ROS 1 密钥
RUN curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add -

# 更新包列表并安装 ROS Noetic
RUN apt-get update
RUN apt-get install -y \
    ros-noetic-desktop-full \
    python3-rosdep \
    python3-rosinstall \
    python3-rosinstall-generator \
    python3-wstool \
    python3-catkin-tools \
    ros-noetic-geographic-msgs \
    ros-noetic-tf2-sensor-msgs \
    ros-noetic-tf2-geometry-msgs 


# ====== 安装 ROS2 Foxy ======
# 添加 ROS 2 仓库
RUN curl -s https://gitee.com/ohhuo/rosdistro/raw/master/ros.asc | sudo apt-key add - && \
    sh -c 'echo "deb [arch=$(dpkg --print-architecture)] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2-latest.list'

# 更新包列表并安装 ROS2 Foxy

RUN apt-get update 

RUN apt-get install -y \
    ros-foxy-desktop \
    python3-colcon-common-extensions \
    python3-argcomplete \
    ros-foxy-geographic-msgs \
    ros-foxy-tf2-sensor-msgs \
    ros-foxy-tf2-geometry-msgs 

RUN apt-get install -y \
pkg-config \
    # Point-LIO 核心依赖
    libgoogle-glog-dev \
    libgflags-dev \
    libgtest-dev \
    # 数学和算法库
    libeigen3-dev \
    libceres-dev \
    # PCL 相关
    libpcl-dev \
    # 其他可能需要的库
    libtbb-dev \
    libopencv-dev \
    libyaml-cpp-dev \
    # ROS 相关依赖
    ros-noetic-pcl-conversions \
    ros-noetic-pcl-ros \
    ros-noetic-sensor-msgs \
    ros-noetic-geometry-msgs \
    ros-noetic-nav-msgs \
    ros-noetic-visualization-msgs \
    ros-noetic-tf \
    ros-noetic-tf2 \
    ros-noetic-tf2-ros 
# 切换到 root 用户
USER root

# 创建目录并克隆仓库
RUN mkdir -p /root/libs && \
    mkdir -p /root/ros1_ws/src && \
    mkdir -p /root/ros2_ws/src

# 添加 Point-LIO 到 ROS1 工作空间
ADD Point-LIO /root/ros1_ws/src/Point-LIO

# 克隆 Livox SDK2
RUN cd /root/libs && \
    git clone https://github.com/Livox-SDK/Livox-SDK2.git

# 克隆 Livox ROS2 驱动
RUN cd /root/libs && \
    mkdir -p livox_ros_driver2_ws/src && \
    cd livox_ros_driver2_ws/src && \
    git clone https://github.com/Livox-SDK/livox_ros_driver2.git

# 安装 Livox SDK2
RUN cd /root/libs/Livox-SDK2 && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc) && \
    make install

# 安装 Livox ROS1 驱动
RUN cd /root/libs/livox_ros_driver2_ws/src/livox_ros_driver2 && \
    /bin/bash -c "source /opt/ros/noetic/setup.bash && ./build.sh ROS1"

# 编译 Point-LIO (ROS1)
RUN cd /root/ros1_ws && \
    /bin/bash -c "source /opt/ros/noetic/setup.bash && source /root/libs/livox_ros_driver2_ws/devel/setup.bash && catkin_make"

RUN apt-get install -y \
 ros-foxy-ros1-bridge \
 tmux

ADD entrypoint.sh /root/entrypoint.sh

CMD [ "entrypoint.sh" ]
